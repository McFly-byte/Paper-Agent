# 复制为 .env 后填写。勿将含真实 Key 的 .env 提交仓库。

# 硅基流动 SiliconFlow（models.yaml 使用 siliconflow 时必填，见 src/core/models.yaml）
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# Ollama 服务端并发（由 ollama serve / Ollama 桌面端进程读取，非本 FastAPI 进程）
# Windows：用户环境变量 OLLAMA_NUM_PARALLEL=2，或在启动 Ollama 前执行
#   setx OLLAMA_NUM_PARALLEL 2
# 修改后需完全退出并重新启动 Ollama。
# OLLAMA_NUM_PARALLEL=2

# LangSmith 配置（强烈推荐开启，用于生产级 Agent 可观测性 + 评估）
# 1. 访问 https://smith.langchain.com/ 注册账号，获取 API Key
# 2. 开启后可在 LangSmith Dashboard 查看：
#    - 完整 LangGraph trace tree (每个节点、LLM 调用、Tool 使用)
#    - LLM-as-Judge 评估结果 (分析深度、写作质量、RAG 利用率、报告完整性)
#    - 评分趋势、对比实验、反馈循环
# 参考官方教程：https://langsmith.langchain.ac.cn/observability/how_to_guides/trace_with_langgraph
# 亦见 LangSmith 评估入门：https://docs.langchain.com/langsmith/evaluation-quickstart

# 二选一即可；若只配 LANGSMITH_API_KEY，启动时会自动同步到 LANGCHAIN_API_KEY 供 LangGraph 使用
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
LANGCHAIN_PROJECT=paper-agent
# LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_V2=true  # 由 config.py 在 tracing 开启时自动设置

# Phase 1：LlamaIndex RAG（与 legacy Chroma 并存；关闭时零行为变化）
# RAG_BACKEND=legacy
# RAG_BACKEND=llamaindex
# LLAMAINDEX_ENABLE=false
# LLAMAINDEX_TOP_K=5
# LLAMAINDEX_QUERY_MODE=plain
# LLAMAINDEX_QUERY_MODE=hyde
# LLAMAINDEX_ENABLE_RERANK=false
# LLAMAINDEX_ENABLE_METADATA_FILTERS=false

# RAG 离线评估（scripts/run_langsmith_rag_eval.py）：有 Chroma 知识库时填写 db_id，否则脚本为「纯 LLM」对照
# RAG_EVAL_DB_ID=

# ---------- LLM 路由与百炼（DashScope OpenAI 兼容，见 src/core/models.yaml llm-routing）----------
# DEFAULT_LLM_PROVIDER=siliconflow|bailian|dashscope
# DEFAULT_EMBEDDING_PROVIDER=siliconflow|bailian|dashscope
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BATCH_BASE_URL=https://batch.dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_COMPLEX_REASONING=qwen3.6-plus
# MODEL_LIGHT_TASK=qwen3.5-flash
# MODEL_RAG_GENERATION=qwen3.5-flash
# MODEL_LANGSMITH_EVAL=qwen3.5-flash
# MODEL_FALLBACK_LIGHT=qwen3.5-flash
# ENABLE_THINKING_FOR_COMPLEX=true
# ENABLE_THINKING_FOR_LIGHT=false
# BAILIAN_QWEN36PLUS_RPM=
# BAILIAN_QWEN36PLUS_TPM=
# BAILIAN_QWEN35FLASH_RPM=
# BAILIAN_QWEN35FLASH_TPM=
# REALTIME_HIGH_PRIORITY_MAX_CONCURRENCY=
# REALTIME_LOW_PRIORITY_MAX_CONCURRENCY=
# BATCH_MAX_CONCURRENCY=
# REQUEST_TIMEOUT_SECONDS=
# MAX_RETRIES=
