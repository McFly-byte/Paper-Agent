# 复制为 .env 后填写。勿将含真实 Key 的 .env 提交仓库。

# Ollama 服务端并发（由 ollama serve / Ollama 桌面端进程读取，非本 FastAPI 进程）
# Windows：用户环境变量 OLLAMA_NUM_PARALLEL=2，或在启动 Ollama 前执行
#   setx OLLAMA_NUM_PARALLEL 2
# 修改后需完全退出并重新启动 Ollama。
# OLLAMA_NUM_PARALLEL=2

# LangSmith 配置（强烈推荐开启，用于生产级 Agent 可观测性 + 评估）
# 1. 访问 https://smith.langchain.com/ 注册账号，获取 API Key
# 2. 开启后可在 LangSmith Dashboard 查看：
#    - 完整 LangGraph trace tree (每个节点、LLM 调用、Tool 使用)
#    - LLM-as-Judge 评估结果 (分析深度、写作质量、RAG 利用率、报告完整性)
#    - 评分趋势、对比实验、反馈循环
# 参考官方教程：https://langsmith.langchain.ac.cn/observability/how_to_guides/trace_with_langgraph

LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here
LANGCHAIN_PROJECT=paper-agent
# LANGCHAIN_TRACING_V2=true  # 由 config.py 自动设置
